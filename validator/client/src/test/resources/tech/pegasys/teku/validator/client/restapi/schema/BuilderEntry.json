{
  "title" : "BuilderEntry",
  "type" : "object",
  "required" : [ "url" ],
  "properties" : {
    "url" : {
      "type" : "string",
      "description" : "The URL this entry's requests are sent to.",
      "example" : "https://builder.example.com",
      "format" : "uri",
      "minLength" : 1,
      "maxLength" : 2048
    },
    "auth_data" : {
      "type" : "string",
      "pattern" : "^0x(?:[a-fA-F0-9]{2}){1,4096}$",
      "description" : "Opaque data used to authenticate this validator's requests to the builder. Omitting it leaves the validator client to set it to the UTF-8 bytes of the entry's url.",
      "example" : "0x68747470733a2f2f6275696c6465722e6578616d706c652e636f6d"
    },
    "builder_pubkeys" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/components/schemas/Pubkey"
      }
    },
    "max_execution_payment" : {
      "type" : "string",
      "description" : "unsigned 64 bit integer",
      "example" : "1",
      "format" : "uint64"
    },
    "min_bid" : {
      "type" : "string",
      "description" : "unsigned 64 bit integer",
      "example" : "1",
      "format" : "uint64"
    },
    "builder_boost_factor" : {
      "type" : "string",
      "description" : "unsigned 64 bit integer",
      "example" : "1",
      "format" : "uint64"
    }
  }
}